# bodylog-listener 镜像(k8s)—— 多阶段:harbor golang:1.24 编 CGO 二进制 → harbor debian:12-slim 运行。
# 构建上下文 = openresty 仓库根(才能访问 bodylog-listener-go/)。
#   docker build -f Dockerfile.bodylog -t bodylog-listener:dev .
#   docker build -f Dockerfile.bodylog --build-arg GO_BASE=golang:1.24-bookworm \
#     --build-arg RUNTIME_BASE=debian:12-slim -t bodylog-listener:dev .
#
# go-duckdb 需 CGO(内嵌 libduckdb.a,cxx11 ABI):golang:1.24-bookworm 自带 gcc12(够新);
# debian:12-slim 自带 glibc2.36 + libstdc++6 + libgcc(二进制动态依赖全满足,零 apt)。
# 模块从 GOPROXY 拉(默认阿里云 goproxy,可 --build-arg 换);GOSUMDB=off 避 sum.golang.org(被墙)。
# ⚠️ 用阿里云不用 goproxy.cn:后者对大模块(arrow-go v18)在容器 bridge 里会 connection reset。
# ⚠️ CI runner 若彻底离线(连阿里云 goproxy 都不通),需先 `go mod vendor` 入库并加 -mod=vendor。
# Defaults are public images so a plain checkout builds; CI overrides them with
# --build-arg to the mirror its runner can reach.
ARG GO_BASE=golang:1.24-bookworm
ARG RUNTIME_BASE=debian:12-slim
ARG GOPROXY=https://mirrors.tencent.com/go/,direct

FROM ${GO_BASE} AS builder
ARG GOPROXY
ENV GOPROXY=${GOPROXY} GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=1 GOOS=linux GOARCH=amd64
WORKDIR /src
COPY bodylog-listener-go/go.mod bodylog-listener-go/go.sum ./
RUN go mod download
COPY bodylog-listener-go/ ./
RUN go build -ldflags="-s -w" -o /bodylog-listener .

FROM ${RUNTIME_BASE}
# 注:bash 已在 debian:12-slim 自带。曾在此 apt 装 vim,但 CI runner 出网被拦、debian 源 GPG NO_PUBKEY
# → apt-get 失败。要 vim 请把它 bake 进 RUNTIME_BASE(联网机器上做,类比 openresty-base),别在 CI 里 apt。
COPY --from=builder /bodylog-listener /usr/local/bin/bodylog-listener
ENV BODYLOG_HOST=0.0.0.0 BODYLOG_PORT=9999 \
    BODYLOG_HTTP_HOST=0.0.0.0 BODYLOG_HTTP_PORT=9998 \
    BODYLOG_DIR=/data/bodylog
EXPOSE 9999 9998
ENTRYPOINT ["/usr/local/bin/bodylog-listener"]
