# bodylog-listener 镜像(k8s)—— 单阶段:harbor debian:12-slim(自带 glibc2.36 + libstdc++6 + libgcc)
# + COPY 预编译的 linux/amd64 二进制。构建上下文 = openresty 仓库根。
#   docker build -f Dockerfile.bodylog -t registry.example.com/llm/bodylog-listener:<tag> .
#
# 为什么不在此多阶段 go build:bodylog 依赖 go-duckdb(CGO,内嵌 C++ libduckdb.a,新 cxx11 ABI),
# 需 go1.24 + gcc>=9 + 能拉 go module 的环境;org 的离线 harbor CI runner 编不了。
# 所以二进制由**单独的编译步骤**产出(见 bodylog-listener-go/compile.sh):
#   在有 go1.24 + gcc9(如 CentOS7 devtoolset-9)或 golang:1.24-bookworm 容器里、GOPROXY 可达:
#     CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o bodylog-listener-linux .
#   产物动态链 libstdc++.so.6/libgcc_s.so.1/glibc —— debian:12-slim 全都自带,直接跑。
# 把产物放到 bodylog-listener-go/bodylog-listener-linux(下面 COPY 它)。
ARG RUNTIME_BASE=registry.example.com/llm/debian:12-slim
ARG BIN=bodylog-listener-go/bodylog-listener-linux
FROM ${RUNTIME_BASE}
ARG BIN
COPY ${BIN} /usr/local/bin/bodylog-listener
ENV BODYLOG_HOST=0.0.0.0 BODYLOG_PORT=9999 \
    BODYLOG_HTTP_HOST=0.0.0.0 BODYLOG_HTTP_PORT=9998 \
    BODYLOG_DIR=/data/bodylog
EXPOSE 9999 9998
ENTRYPOINT ["/usr/local/bin/bodylog-listener"]
